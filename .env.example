# ---------------------------------------------------------------------------
# Suay.store — environment configuration
# Copy to `.env` and fill in. Never commit a real `.env`.
# ---------------------------------------------------------------------------

# PostgreSQL connection string.
DATABASE_URL="postgresql://suay:suay@127.0.0.1:5432/suay?schema=public"

# Separate database used by `npm test`. Tests truncate it between runs.
TEST_DATABASE_URL="postgresql://suay:suay@127.0.0.1:5432/suay_test?schema=public"

# Secret used to sign session cookies (HS256). Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
AUTH_SECRET="replace-me-with-a-long-random-string-at-least-32-chars"

# Session lifetime in seconds (default 7 days).
AUTH_SESSION_TTL_SECONDS="604800"

# ---------------------------------------------------------------------------
# Booking engine
# ---------------------------------------------------------------------------

# How long a slot is held while the customer completes payment.
BOOKING_HOLD_MINUTES="10"

# Granularity of generated start times, in minutes.
BOOKING_SLOT_INTERVAL_MINUTES="15"

# How far ahead customers may book.
BOOKING_MAX_ADVANCE_DAYS="60"

# Minimum notice before a slot can be booked, in minutes.
BOOKING_MIN_NOTICE_MINUTES="60"

# ---------------------------------------------------------------------------
# Payments — no real credentials are required to run this project.
# `mock` simulates authorisation, capture, refund and webhooks locally.
# ---------------------------------------------------------------------------

PAYMENT_GATEWAY_PROVIDER="mock"
PAYMENT_WEBHOOK_SECRET="dev-webhook-secret"
PAYMENT_GATEWAY_KEY=""
PAYMENT_GATEWAY_SECRET=""

# Commercial policy defaults (configurable, not hard-coded in business logic).
PLATFORM_COMMISSION_BPS="1200"
BOOKING_DEPOSIT_PERCENT="100"
CANCELLATION_FREE_HOURS="24"
CANCELLATION_LATE_FEE_PERCENT="50"

# ---------------------------------------------------------------------------
# LINE — optional. When unset, the mock LINE adapter is used.
# ---------------------------------------------------------------------------

LINE_LOGIN_MODE="mock"
LINE_CHANNEL_ID=""
LINE_CHANNEL_SECRET=""
LINE_LIFF_ID=""
LINE_MESSAGING_TOKEN=""

# ---------------------------------------------------------------------------
# Notifications — `mock` records deliveries in the database without sending.
# ---------------------------------------------------------------------------

NOTIFICATION_TRANSPORT="mock"
EMAIL_FROM="no-reply@suay.store"

# ---------------------------------------------------------------------------
# Platform
# ---------------------------------------------------------------------------

PLATFORM_TIMEZONE="Asia/Bangkok"
PLATFORM_CURRENCY="THB"
NEXT_PUBLIC_DEMO_MODE="true"
